{% comment %}
CUSTOM FILE [PR-002] — PawRoutine announcement marquee section | See docs/CUSTOM_CHANGES.md#PR-002
{% endcomment %}

{% liquid
  assign message_count = 0

  for block in section.blocks
    assign message_text = block.settings.text | strip

    if message_text != blank
      assign message_count = message_count | plus: 1
    endif
  endfor

  assign message_repetitions = 4

  if message_count == 1
    assign message_repetitions = 8
  elsif message_count == 2
    assign message_repetitions = 5
  endif
%}

{% if section.settings.enabled and message_count > 0 %}
  {{ 'pawroutine-announcement-marquee.css' | asset_url | stylesheet_tag }}

  <aside
    id="PawRoutineAnnouncementMarquee-{{ section.id }}"
    class="pawroutine-announcement-marquee"
    role="region"
    aria-label="{{ section.settings.accessibility_label | escape }}"
    style="
      --pr-announcement-bg: {{ section.settings.background_color }};
      --pr-announcement-text: {{ section.settings.text_color }};
      --pr-announcement-speed: {{ section.settings.scroll_speed }}s;
      --pr-announcement-text-size: {{ section.settings.text_size }}px;
      --pr-announcement-gap: {{ section.settings.gap }}px;
      --pr-announcement-padding-block: {{ section.settings.vertical_padding }}px;
      --pr-announcement-letter-spacing: {{ section.settings.letter_spacing | divided_by: 100.0 }}em;
    "
  >
    <div class="pawroutine-announcement-marquee__viewport">
      <div class="pawroutine-announcement-marquee__track">
        {% for group_index in (1..2) %}
          <div
            class="pawroutine-announcement-marquee__group"
            {% if group_index == 2 %}
              aria-hidden="true"
            {% endif %}
          >
            {% for repetition in (1..message_repetitions) %}
              {% for block in section.blocks %}
                {% liquid
                  assign message_text = block.settings.text | strip
                  assign message_link = block.settings.link
                  assign is_visual_duplicate = false

                  if group_index == 2 or repetition > 1
                    assign is_visual_duplicate = true
                  endif
                %}

                {% if message_text != blank %}
                  {% if message_link != blank %}
                    <a
                      class="pawroutine-announcement-marquee__item pawroutine-announcement-marquee__item--link"
                      href="{{ message_link }}"
                      {% if is_visual_duplicate %}
                        aria-hidden="true"
                        tabindex="-1"
                      {% endif %}
                      {% if group_index == 1 and repetition == 1 %}
                        {{ block.shopify_attributes }}
                      {% endif %}
                    >
                      {{ message_text | escape }}
                    </a>
                  {% else %}
                    <span
                      class="pawroutine-announcement-marquee__item"
                      {% if is_visual_duplicate %}
                        aria-hidden="true"
                      {% endif %}
                      {% if group_index == 1 and repetition == 1 %}
                        {{ block.shopify_attributes }}
                      {% endif %}
                    >
                      {{ message_text | escape }}
                    </span>
                  {% endif %}
                {% endif %}
              {% endfor %}
            {% endfor %}
          </div>
        {% endfor %}
      </div>
    </div>
  </aside>
{% endif %}

{% schema %}
{
  "name": "PawRoutine marquee",
  "tag": "section",
  "class": "shopify-section-pawroutine-announcement-marquee",
  "enabled_on": {
    "groups": ["header"]
  },
  "max_blocks": 3,
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Message text",
          "default": "FREE SHIPPING OVER £35"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional link"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable announcement marquee",
      "default": true
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Store announcements"
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "label": "Scroll speed",
      "min": 10,
      "max": 60,
      "step": 1,
      "unit": "sec",
      "default": 26
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between messages",
      "min": 16,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "%",
      "default": 12
    },
    {
      "type": "header",
      "content": "Colors and spacing"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#6A284F"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "vertical_padding",
      "label": "Vertical padding",
      "min": 6,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 9
    }
  ],
  "presets": [
    {
      "name": "PawRoutine marquee",
      "blocks": [
        {
          "type": "announcement",
          "settings": {
            "text": "FREE SHIPPING OVER £35"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "SIMPLE DAILY PET CARE"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "GENTLE ROUTINES FOR HAPPY PETS"
          }
        }
      ]
    }
  ]
}
{% endschema %}