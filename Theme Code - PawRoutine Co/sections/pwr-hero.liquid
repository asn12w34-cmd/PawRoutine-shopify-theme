{% comment %}
CUSTOM FILE [PR-003] — PawRoutine split promo hero section | See docs/CUSTOM_CHANGE_PAWROUTINE.md#PR-003
{% endcomment %}

{% liquid
  assign desktop_image = section.settings.desktop_image
  assign mobile_image = section.settings.mobile_image
  assign heading_plain = section.settings.heading | strip_html | strip
  assign supporting_text_plain = section.settings.supporting_text | strip_html | strip
  assign button_label = section.settings.button_label | strip
  assign button_link = section.settings.button_link
  assign has_media = false
  assign has_button = false
  assign has_content = false

  if desktop_image == blank and mobile_image != blank
    assign desktop_image = mobile_image
    assign mobile_image = blank
  endif

  if desktop_image != blank
    assign has_media = true
  endif

  if button_label != blank and button_link != blank
    assign has_button = true
  endif

  if heading_plain != blank or supporting_text_plain != blank or has_button
    assign has_content = true
  endif

  assign image_alt = desktop_image.alt
  if mobile_image != blank and mobile_image.alt != blank
    assign image_alt = mobile_image.alt
  endif

  assign desktop_widths = '480, 720, 960, 1200, 1600, 2000'
  assign mobile_widths = '375, 550, 750, 900'
  assign mobile_widths_array = mobile_widths | split: ', '
  assign image_sizes = '(min-width: 990px) 58vw, (min-width: 750px) 70vw, 100vw'
%}

{% if has_media or has_content or request.design_mode %}
  {{ 'pwr-hero.css' | asset_url | stylesheet_tag }}

  <section
    id="PawRoutineSplitPromoHero-{{ section.id }}"
    class="
      pawroutine-split-promo-hero
      color-{{ section.settings.color_scheme }}
      pawroutine-split-promo-hero--media-{{ section.settings.desktop_media_position }}
      pawroutine-split-promo-hero--desktop-spacing-{{ section.settings.desktop_spacing }}
      pawroutine-split-promo-hero--mobile-spacing-{{ section.settings.mobile_spacing }}
      {% unless has_media %}pawroutine-split-promo-hero--without-media{% endunless %}
    "
    data-testid="pawroutine-split-promo-hero"
  >
    <div class="pawroutine-split-promo-hero__inner">
      {% if has_content or request.design_mode %}
        <div class="pawroutine-split-promo-hero__content">
          {% if heading_plain != blank %}
            <h2 class="pawroutine-split-promo-hero__heading">
              {{ section.settings.heading }}
            </h2>
          {% elsif request.design_mode %}
            <h2 class="pawroutine-split-promo-hero__heading pawroutine-split-promo-hero__heading--placeholder">
              Add a campaign heading
            </h2>
          {% endif %}

          {% if supporting_text_plain != blank %}
            <div class="pawroutine-split-promo-hero__description rte">
              {{ section.settings.supporting_text }}
            </div>
          {% endif %}

          {% if has_button %}
            <a class="button pawroutine-split-promo-hero__button" href="{{ button_link }}">
              {{ button_label | escape }}
            </a>
          {% elsif request.design_mode and button_label != blank %}
            <span class="button pawroutine-split-promo-hero__button" aria-disabled="true">
              {{ button_label | escape }}
            </span>
          {% endif %}
        </div>
      {% endif %}

      {% if has_media %}
        <div class="pawroutine-split-promo-hero__media">
          <div class="pawroutine-split-promo-hero__media-frame">
            <picture class="pawroutine-split-promo-hero__picture">
              {% if mobile_image != blank %}
                <source
                  media="(max-width: 749px)"
                  srcset="
                    {%- for mobile_width in mobile_widths_array -%}
                      {{ mobile_image | image_url: width: mobile_width }} {{ mobile_width }}w{% unless forloop.last %}, {% endunless %}
                    {%- endfor -%}
                  "
                  sizes="100vw"
                >
              {% endif %}
              {{
                desktop_image
                | image_url: width: 2000
                | image_tag:
                  width: desktop_image.width,
                  widths: desktop_widths,
                  height: desktop_image.height,
                  alt: image_alt,
                  class: 'pawroutine-split-promo-hero__image',
                  sizes: image_sizes,
                  loading: 'lazy',
                  fetchpriority: 'low'
              }}
            </picture>
          </div>
        </div>
      {% elsif request.design_mode %}
        <div class="pawroutine-split-promo-hero__media pawroutine-split-promo-hero__media--placeholder" aria-hidden="true">
          <div class="pawroutine-split-promo-hero__media-frame">
            {{ 'lifestyle-1' | placeholder_svg_tag: 'pawroutine-split-promo-hero__placeholder' }}
          </div>
        </div>
      {% endif %}
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "Pwr split hero",
  "tag": "section",
  "class": "shopify-section-pawroutine-split-promo-hero",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "info": "Optional. The desktop image is used on mobile when this is blank."
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Daily care, gently made."
    },
    {
      "type": "richtext",
      "id": "supporting_text",
      "label": "Supporting text",
      "default": "<p>Thoughtfully made essentials for happier, healthier daily routines.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "desktop_media_position",
      "label": "Desktop image position",
      "options": [
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ],
      "default": "right"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    },
    {
      "type": "select",
      "id": "desktop_spacing",
      "label": "Desktop spacing",
      "options": [
        {
          "value": "compact",
          "label": "Compact"
        },
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "generous",
          "label": "Generous"
        }
      ],
      "default": "standard"
    },
    {
      "type": "select",
      "id": "mobile_spacing",
      "label": "Mobile spacing",
      "options": [
        {
          "value": "compact",
          "label": "Compact"
        },
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "generous",
          "label": "Generous"
        }
      ],
      "default": "standard"
    }
  ],
  "presets": [
    {
      "name": "Pwr split hero"
    }
  ]
}
{% endschema %}
