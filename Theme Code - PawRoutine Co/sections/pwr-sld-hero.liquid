{% comment %}
CUSTOM FILE [PR-006] — PawRoutine homepage hero slideshow section | See docs/CUSTOM_CHANGES.md#PR-006
{% endcomment %}

{{ 'pwr-sld-hero.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pwr-sld-hero.js' | asset_url }}" defer="defer"></script>

{% liquid
  assign slide_count = section.blocks.size
  assign has_multiple_slides = false
  if slide_count > 1
    assign has_multiple_slides = true
  endif

  assign hero_id = 'PwrSldHero-' | append: section.id
  assign slides_id = 'PwrSldHeroSlides-' | append: section.id
  assign status_id = 'PwrSldHeroStatus-' | append: section.id

  assign desktop_widths = '750, 1100, 1500, 2000, 2400, 3000'
  assign mobile_widths = '375, 550, 750, 900, 1200'
  assign mobile_widths_array = mobile_widths | split: ', '
%}

<section
  id="{{ hero_id }}"
  class="pwr-sld-hero-section pwr-sld-hero-section--desktop-{{ section.settings.desktop_height }} pwr-sld-hero-section--mobile-{{ section.settings.mobile_height }}"
  style="--pwr-sld-transition: {{ section.settings.transition_speed }}ms;"
  data-testid="pwr-sld-hero"
>
  <pwr-sld-hero
    class="pwr-sld-hero"
    data-pwr-sld-hero
    data-section-id="{{ section.id }}"
    data-autoplay="{{ section.settings.autoplay }}"
    data-interval="{{ section.settings.autoplay_speed | times: 1000 }}"
    data-transition="{{ section.settings.transition_speed }}"
  >
    <div
      class="pwr-sld-hero__viewport"
      role="region"
      aria-roledescription="carousel"
      aria-label="Featured PawRoutine promotions"
    >
      <h2 class="visually-hidden">Featured PawRoutine promotions</h2>

      <div id="{{ slides_id }}" class="pwr-sld-hero__slides" data-pwr-sld-slides>
        {% for block in section.blocks %}
          {% liquid
            assign desktop_image = block.settings.desktop_image
            assign mobile_image = block.settings.mobile_image
            assign eyebrow = block.settings.eyebrow | strip
            assign heading_plain = block.settings.heading | strip_html | strip
            assign button_label = block.settings.button_label | strip
            assign button_link = block.settings.button_link
            assign has_button = false
            assign has_media = false

            if desktop_image == blank and mobile_image != blank
              assign desktop_image = mobile_image
              assign mobile_image = blank
            endif

            if desktop_image != blank
              assign has_media = true
            endif

            if button_label != blank and button_link != blank
              assign has_button = true
            endif

            assign image_alt = desktop_image.alt
            if image_alt == blank
              assign image_alt = ''
            endif

            if forloop.first
              assign image_loading = 'eager'
              assign image_fetchpriority = 'high'
            else
              assign image_loading = 'lazy'
              assign image_fetchpriority = 'low'
            endif

            capture slide_label
              echo 'Slide '
              echo forloop.index
              echo ' of '
              echo slide_count
            endcapture
          %}

          <article
            class="pwr-sld-hero__slide pwr-sld-hero__slide--tone-{{ block.settings.text_tone }} pwr-sld-hero__slide--overlay-{{ block.settings.overlay_strength }}{% if forloop.first %} is-active{% endif %}"
            data-pwr-sld-slide
            data-slide-index="{{ forloop.index0 }}"
            aria-roledescription="slide"
            aria-label="{{ slide_label | strip | escape }}"
            aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
            {% unless forloop.first %}inert{% endunless %}
            {{ block.shopify_attributes }}
          >
            <div class="pwr-sld-hero__media" aria-hidden="{% if image_alt == blank %}true{% else %}false{% endif %}">
              {% if has_media %}
                <picture class="pwr-sld-hero__picture">
                  {% if mobile_image != blank %}
                    <source
                      media="(max-width: 749px)"
                      srcset="
                        {%- for mobile_width in mobile_widths_array -%}
                          {{ mobile_image | image_url: width: mobile_width }} {{ mobile_width }}w{% unless forloop.last %}, {% endunless %}
                        {%- endfor -%}
                      "
                      sizes="100vw"
                    >
                  {% endif %}
                  {{
                    desktop_image
                    | image_url: width: 3000
                    | image_tag:
                      widths: desktop_widths,
                      sizes: '100vw',
                      loading: image_loading,
                      fetchpriority: image_fetchpriority,
                      class: 'pwr-sld-hero__image',
                      alt: image_alt
                  }}
                </picture>
              {% else %}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'pwr-sld-hero__placeholder' }}
              {% endif %}
              <div class="pwr-sld-hero__overlay"></div>
            </div>

            <div class="pwr-sld-hero__content-wrap">
              <div class="pwr-sld-hero__content">
                {% if eyebrow != blank %}
                  <p class="pwr-sld-hero__eyebrow">{{ eyebrow | escape }}</p>
                {% endif %}

                {% if heading_plain != blank %}
                  <h3 class="pwr-sld-hero__heading">{{ block.settings.heading }}</h3>
                {% elsif request.design_mode %}
                  <h3 class="pwr-sld-hero__heading pwr-sld-hero__heading--placeholder">Add a slide heading</h3>
                {% endif %}

                {% if has_button %}
                  <a class="button pwr-sld-hero__button" href="{{ button_link }}">
                    {{ button_label | escape }}
                  </a>
                {% elsif request.design_mode and button_label != blank %}
                  <span class="button pwr-sld-hero__button" aria-disabled="true">
                    {{ button_label | escape }}
                  </span>
                {% endif %}
              </div>
            </div>
          </article>
        {% endfor %}
      </div>

      {% if section.blocks.size == 0 and request.design_mode %}
        <div class="pwr-sld-hero__empty" aria-hidden="true">
          <p>Add at least one slide block to configure this hero.</p>
        </div>
      {% endif %}

      {% if has_multiple_slides %}
        <div class="pwr-sld-hero__controls" role="group" aria-label="Slideshow controls">
          {% if section.settings.autoplay %}
            <button
              type="button"
              class="pwr-sld-hero__control"
              data-pwr-sld-toggle
              aria-controls="{{ slides_id }}"
              aria-label="Pause slideshow"
              aria-pressed="false"
            >
              <svg class="pwr-sld-hero__icon pwr-sld-hero__icon--pause" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M8 6.75v10.5M16 6.75v10.5"></path>
              </svg>
              <svg class="pwr-sld-hero__icon pwr-sld-hero__icon--play" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="m9 6.75 8 5.25L9 17.25z"></path>
              </svg>
              <span class="visually-hidden" data-pwr-sld-toggle-label>Pause slideshow</span>
            </button>
          {% endif %}

          <button
            type="button"
            class="pwr-sld-hero__control"
            data-pwr-sld-previous
            aria-controls="{{ slides_id }}"
            aria-label="Previous slide"
          >
            <svg class="pwr-sld-hero__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="m14.5 5-7 7 7 7"></path>
            </svg>
          </button>

          <button
            type="button"
            class="pwr-sld-hero__control"
            data-pwr-sld-next
            aria-controls="{{ slides_id }}"
            aria-label="Next slide"
          >
            <svg class="pwr-sld-hero__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="m9.5 5 7 7-7 7"></path>
            </svg>
          </button>
        </div>
      {% endif %}

      <p id="{{ status_id }}" class="visually-hidden" aria-live="polite" aria-atomic="true" data-pwr-sld-status></p>
    </div>
  </pwr-sld-hero>
</section>

{% schema %}
{
  "name": "Pwr slider hero",
  "tag": "section",
  "class": "shopify-section-pwr-sld-hero",
  "enabled_on": {
    "templates": ["index"]
  },
  "max_blocks": 5,
  "settings": [
    {
      "type": "select",
      "id": "desktop_height",
      "label": "Desktop hero height",
      "options": [
        {
          "value": "tall",
          "label": "Tall"
        },
        {
          "value": "viewport",
          "label": "Near full screen"
        }
      ],
      "default": "tall"
    },
    {
      "type": "select",
      "id": "mobile_height",
      "label": "Mobile hero height",
      "options": [
        {
          "value": "compact",
          "label": "Compact"
        },
        {
          "value": "standard",
          "label": "Standard"
        }
      ],
      "default": "standard"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay delay",
      "min": 6,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 9,
      "visible_if": "{{ section.settings.autoplay }}"
    },
    {
      "type": "range",
      "id": "transition_speed",
      "label": "Fade duration",
      "min": 400,
      "max": 1000,
      "step": 100,
      "unit": "ms",
      "default": 700
    }  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image",
          "info": "Optional. Use a separate mobile image only when the desktop crop does not leave enough clear space for the centred copy."
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading",
          "default": "Daily care, gently made."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "text_tone",
          "label": "Text tone",
          "options": [
            {
              "value": "light",
              "label": "Light"
            },
            {
              "value": "dark",
              "label": "Dark"
            }
          ],
          "default": "light"
        },
        {
          "type": "select",
          "id": "overlay_strength",
          "label": "Dark image overlay",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "light",
              "label": "Light"
            },
            {
              "value": "medium",
              "label": "Medium"
            }
          ],
          "default": "light"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pwr slider hero",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
